# Chave usada pelos clientes para autenticar no proxy local.
# Troque por uma chave própria antes de expor a porta fora do PC.
LITELLM_MASTER_KEY=sk-local-dev-change-me

# Ollama rodando no host, fora do container LiteLLM.
OLLAMA_API_BASE=http://host.docker.internal:11434

# Evita chamadas externas do LiteLLM em um setup totalmente local.
LITELLM_OFFLINE_MODE=true
